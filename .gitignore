/.phpunit.cache
# Laravel Standard Ignores
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
# Sensitive PII/private storage (CV, selfies, dispute docs, DB backups) - never commit
/storage/app/private/
/vendor
